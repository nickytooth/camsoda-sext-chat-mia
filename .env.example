# xAI (Grok) — chat and moderation
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.3

# Google (Gemini) — classification, summarization, and generation fallback
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# OpenAI — embeddings only
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Persona (single always-open persona)
SINGLE_PERSONA_FILE=personas/mia.yaml

# Database (PostgreSQL). The database itself must already exist; tables are
# created automatically on startup. Defaults to a local dev instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mia

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8001

# Default user ID (single-user demo)
DEFAULT_USER_ID=1

# Visual content catalog and demo token wallet
MEDIA_CATALOG_FILE=.private-media/media_catalog.yaml
MEDIA_PHOTO_PRICE_TOKENS=5
MEDIA_VIDEO_PRICE_TOKENS=10
DEMO_WALLET_INITIAL_TOKENS=1000
DEMO_WALLET_REFILL_TOKENS=1000

# Sales pacing (processed chat batches, not raw WebSocket messages)
MEDIA_PROACTIVE_MIN_BATCHES=8
MEDIA_PROACTIVE_COOLDOWN_BATCHES=8
MEDIA_REPEAT_COOLDOWN_BATCHES=8
MEDIA_SOFT_DECLINE_MIN_BATCHES=30
MEDIA_SOFT_DECLINE_MAX_BATCHES=40
MEDIA_HARD_DECLINE_SNOOZE_BATCHES=100
MEDIA_CONFIRMATION_TTL_SECONDS=600
MEDIA_CONFIRMATION_MAX_BATCH_GAP=4
MEDIA_CONFIRMATION_GRANT_SECONDS=3600

# Persistent conversation heat resets to normal flirting after this many
# seconds without a sexual processed batch.
HEAT_SESSION_TIMEOUT_SECONDS=3600

# Cloudflare R2 private media bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Offline media pipeline only. Use a separate bucket-scoped read/write token;
# the backend runtime credentials above should remain read-only.
R2_UPLOAD_ACCESS_KEY_ID=
R2_UPLOAD_SECRET_ACCESS_KEY=
R2_SIGNED_PHOTO_TTL_SECONDS=600
R2_SIGNED_VIDEO_TTL_SECONDS=3600
R2_SIGNED_PREVIEW_TTL_SECONDS=3600

# Internal-only destructive commerce reset endpoint. Keep disabled outside
# deliberately disposable local/demo environments.
COMMERCE_DEV_RESET_ENABLED=false
